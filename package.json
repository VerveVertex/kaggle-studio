{
  "name": "kaggle-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/setup.test.mjs tests/maintenance.test.mjs",
