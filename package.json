    "test:manual-ui": "node tests/ui-manual-token.mjs"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "esbuild": "0.28.2"
  }
}
